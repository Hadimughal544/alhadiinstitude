generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
  TEACHER
  STUDENT
}

enum InquiryType {
  DEMO
  ENROLL
  PROJECT
  COURSE
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(USER)
  image         String?
  phone         String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  teacher           TeacherProfile?
  student           StudentProfile?
  googleConnection  GoogleConnection?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Country {
  id             String   @id @default(cuid())
  code           String   @unique
  name           String
  currencyCode   String
  currencySymbol String
  flagEmoji      String
  timezone       String   @default("Asia/Karachi")
  sortOrder      Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  students StudentProfile[]
  teachers TeacherProfile[]
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  subtitle    String
  description String   @db.Text
  heroImage   String?
  features    Json
  faqs        Json
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans    Plan[]
  lectures Lecture[]
}

model Plan {
  id             String   @id @default(cuid())
  serviceId      String
  name           String
  badge          String?
  classesOrHours String?
  durationMins   Int?
  features       Json
  sortOrder      Int      @default(0)
  featured       Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service  Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  prices   PlanPrice[]
  inquiries Inquiry[]
}

model PlanPrice {
  id           String  @id @default(cuid())
  planId       String
  currencyCode String
  amount       Decimal @db.Decimal(12, 2)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, currencyCode])
}

model Inquiry {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String
  countryCode String?
  serviceSlug String
  planId      String?
  course      String?
  ageGroup    String?
  message     String?       @db.Text
  type        InquiryType   @default(DEMO)
  status      InquiryStatus @default(NEW)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)
}

model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model TeacherProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  specialization String?
  countryCode    String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  country  Country?  @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  lectures Lecture[]
}

model StudentProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  ageGroup    String?
  countryCode String?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  country     Country?             @relation(fields: [countryCode], references: [code], onDelete: SetNull)
  enrollments LectureEnrollment[]
}

model Lecture {
  id            String   @id @default(cuid())
  title         String
  dayOfWeek     Int
  startTime     String
  endTime       String
  timezone      String   @default("Asia/Karachi")
  teacherId     String
  serviceId     String?
  meetUrl       String?
  meetSpaceId   String?
  googleEventId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher     TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  service     Service?            @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  enrollments LectureEnrollment[]

  @@index([teacherId, dayOfWeek])
  @@index([dayOfWeek, active])
}

model LectureEnrollment {
  lectureId String
  studentId String

  lecture Lecture        @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([lectureId, studentId])
}

model GoogleConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  email        String
  refreshToken String   @db.Text
  scope        String?  @db.Text
  connectedAt  DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  excerpt         String?    @db.Text
  content         String     @db.Text
  coverImage      String?
  attachmentUrl   String?
  attachmentName  String?
  attachmentType  String?
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?    @db.Text
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}
