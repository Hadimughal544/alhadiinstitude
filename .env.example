# Neon PostgreSQL (pooled connection string from Neon dashboard)
# Create a dedicated database named "alhadi" so it does not conflict with other projects.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/alhadi?sslmode=require"

# Optional: direct (non-pooled) connection for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/alhadi?sslmode=require"

# NextAuth
AUTH_URL="http://localhost:3000"
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Seed admin account
ADMIN_EMAIL="admin@alhadiinstitute.com"
ADMIN_PASSWORD="change-me"

# Contact (also editable in admin settings)
WHATSAPP_NUMBER="447774874052"
CONTACT_EMAIL="info@alhadiinstitute.com"
