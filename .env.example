# Neon PostgreSQL (pooled connection string from Neon dashboard)
# Create a dedicated database named "alhadi" so it does not conflict with other projects.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/alhadi?sslmode=require"

# Optional: direct (non-pooled) connection for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/alhadi?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Auth.js infers the request origin when trustHost is enabled.
# Do not set AUTH_URL or NEXTAUTH_URL to localhost in production.
# If your host requires an explicit URL, use the deployed HTTPS origin:
# AUTH_URL="https://your-domain.com"
# NEXTAUTH_URL="https://your-domain.com"

# Seed admin account
ADMIN_EMAIL="admin@alhadiinstitute.com"
ADMIN_PASSWORD="change-me"

# Contact (also editable in admin settings)
WHATSAPP_NUMBER="447774874052"
CONTACT_EMAIL="info@alhadiinstitute.com"

# Cloudinary (blog image uploads from admin)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public site URL for metadata / sitemap (production)
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
