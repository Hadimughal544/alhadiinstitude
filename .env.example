# Neon PostgreSQL (pooled connection string from Neon dashboard)
# Create a dedicated database named "alhadi" so it does not conflict with other projects.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/alhadi?sslmode=require"

# Optional: direct (non-pooled) connection for migrations
DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/alhadi?sslmode=require"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Auth.js infers the request origin when trustHost is enabled.
# Do not set AUTH_URL or NEXTAUTH_URL to localhost in production.
# If your host requires an explicit URL, use the deployed HTTPS origin:
# AUTH_URL="https://your-domain.com"
# NEXTAUTH_URL="https://your-domain.com"

# Seed admin account
ADMIN_EMAIL="admin@alhadiinstitute.com"
ADMIN_PASSWORD="change-me"

# Contact (also editable in admin settings)
WHATSAPP_NUMBER="447774874052"
CONTACT_EMAIL="info@alhadiinstitute.com"

# Cloudinary (blog image uploads from admin)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public site URL for metadata / sitemap (production)
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Google Meet (required to create class links)
# 1. Create a Google Cloud project and enable the "Google Meet API".
# 2. OAuth consent screen: add the scope
#      https://www.googleapis.com/auth/meetings.space.created
#    and add the institute Google account as a Test user (publish the app for production
#    so the refresh token does not expire on the 7-day testing clock).
# 3. Create OAuth 2.0 Web client credentials with these authorized redirect URIs:
#      http://localhost:3000/api/admin/google/callback
#      https://your-domain.com/api/admin/google/callback
# The admin connects the account once at /admin/settings/google.
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/admin/google/callback"

# 32-byte base64 key that encrypts the stored Google refresh token at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENC_KEY="generate-with-openssl-rand-base64-32"

# Optional: set to "false" to show the class Join button any time before the class
# ends instead of only from 10 minutes before it starts. Defaults to "true".
# JOIN_REQUIRE_WINDOW="true"
